# Leave empty to run the site in demo mode (simulated chain in your browser).
# Set to testnet contract accounts to read live state from NEAR testnet.
PUBLIC_KYP_COORDINATOR=
PUBLIC_KYP_LOCK=
PUBLIC_KYP_POOL=
PUBLIC_KYP_QUOTE=wrap.testnet
PUBLIC_NEAR_RPC=https://rpc.testnet.near.org
# Reference price only for showing USD next to wNEAR. Never used on-chain.
PUBLIC_NEAR_USD=2.0

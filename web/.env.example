# Network: testnet (default) or mainnet. RPC, wNEAR, explorer, MyNearWallet URL and contract IDs
# all follow it. No mainnet contracts exist yet, so a mainnet build runs in demo mode.
PUBLIC_NEAR_NETWORK=testnet

# Contract accounts per network. Leave empty to run the site in demo mode (simulated chain in your browser).
# IDs that don't fit the network (e.g. *.testnet on mainnet) fail the build.
PUBLIC_KYP_TESTNET_COORDINATOR=
PUBLIC_KYP_TESTNET_LOCK=
PUBLIC_KYP_TESTNET_POOL=
# PUBLIC_KYP_TESTNET_QUOTE=wrap.testnet        # default per network (wrap.testnet / wrap.near)
# PUBLIC_NEAR_TESTNET_RPC=https://rpc.testnet.near.org
# PUBLIC_KYP_MAINNET_COORDINATOR=             # not deployed; needs Sushmit's go-ahead
# PUBLIC_KYP_MAINNET_LOCK=
# PUBLIC_KYP_MAINNET_POOL=
# PUBLIC_NEAR_MAINNET_RPC=https://rpc.mainnet.near.org
# Older unprefixed names (PUBLIC_KYP_COORDINATOR, PUBLIC_KYP_LOCK, PUBLIC_KYP_POOL, PUBLIC_KYP_QUOTE,
# PUBLIC_NEAR_RPC) still work, for testnet only.

# Optional WalletConnect (Reown) project ID. Set it to show WalletConnect and Unity Wallet; empty = hidden.
PUBLIC_WALLETCONNECT_PROJECT_ID=

# Reference price only for showing USD next to wNEAR. Never used on-chain.
PUBLIC_NEAR_USD=2.0

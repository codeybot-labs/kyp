# Production build (Cloudflare site): live NEAR TESTNET contracts. Public account IDs only, no secrets.
# Primary = the RHEA DCL copy (real dclv2.ref-dev.testnet pools; verified end to end with in-site test
# wallets on 2026-11-11, see docs/TESTNET.md). Alt = the mock-pool copy, switchable in the header.
PUBLIC_NEAR_NETWORK=testnet
PUBLIC_KYP_TESTNET_COORDINATOR=kyp-sushmit-dcl.testnet
PUBLIC_KYP_TESTNET_LOCK=kyp-sushmit-dcl-lock.testnet
PUBLIC_KYP_TESTNET_POOL=dclv2.ref-dev.testnet
PUBLIC_KYP_TESTNET_LABEL=RHEA DCL
PUBLIC_KYP_TESTNET_ALT_COORDINATOR=kyp-sushmit.testnet
PUBLIC_KYP_TESTNET_ALT_LOCK=kyp-sushmit-lock.testnet
PUBLIC_KYP_TESTNET_ALT_POOL=kyp-sushmit-pool.testnet
PUBLIC_KYP_TESTNET_ALT_LABEL=Mock pool
PUBLIC_NEAR_TESTNET_RPC=https://rpc.testnet.fastnear.com
PUBLIC_NEAR_USD=2.0

// Cloudflare Workers deploy: static assets + a small Worker that ONLY runs for /api/* (Cabal Corner).
// Cost notes (Workers Paid $5 plan): static asset requests stay free and never invoke the Worker
// (run_worker_first is limited to /api/*). The Worker + D1 use the plan's included allowances
// (10M Worker requests/month; D1 25B rows read, 50M rows written, 5 GB). Bodies are capped at 4 KB
// and rows per launch are capped (src/lib/corner.mjs LIMITS). Workers AI stays OFF (no `ai` binding,
// CORNER_AI = "off"). The Corner agent calls Ollama Cloud when the OLLAMA_API_KEY secret is set,
// capped by CORNER_AI_DAILY_CALLS, and falls back to MiniSearch notes on error or timeout.
// Do not add a Workers AI binding or other paid Cloudflare usage.
//
// One-time setup before the first deploy of this config (free):
//   npx wrangler d1 create kyp-corner     -> paste the database_id below
//   npx wrangler d1 migrations apply kyp-corner --remote
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kyp-web",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    { "binding": "CORNER_DB", "database_name": "kyp-corner", "database_id": "b82d2714-c92d-44be-a5e7-dff39e27f857", "migrations_dir": "migrations" }
  ],
  "vars": {
    "CORNER_COORDINATORS": "testnet:kyp-sushmit-dcl.testnet,testnet:kyp-sushmit.testnet",
    "CORNER_RECIPIENTS": "kycabal.fun,kyp-web.sushmitsarmah.workers.dev",
    "CORNER_AI": "off",
    "CORNER_AI_DAILY_CALLS": "150",
    "CORNER_AI_DAILY_NEURONS": "3000"
  },
  // Workers AI stays off. Do not add an `ai` binding.
  "observability": { "enabled": false },
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "kycabal.fun", "custom_domain": true }
  ]
}

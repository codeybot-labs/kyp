---
import Base from "../layouts/Base.astro";
import LaunchList from "../components/LaunchList.tsx";
import Kip from "../components/Kip.astro";
import { NETWORK_LABEL } from "../lib/config";
---
<Base title="Locked presales for NEAR memes" active="/">
  <section class="hero full-bleed">
    <div class="wrap">
      <div>
        <span class="pill"><span class="dot"></span> {NETWORK_LABEL} MVP</span>
        <h1 id="hero-title">Know who holds the early supply. And know they can't dump it.</h1>
        <p class="lead">KYP is an optional presale for meme launches. Launchers hand-pick presalers, everyone buys at one price inside the launch transaction, and the tokens go straight into a lock that opens only at public, ambitious market-cap milestones.</p>
        <div class="btns">
          <a class="btn p" href="/create">Create a launch</a>
          <a class="btn s" href="/how-it-works">How it works</a>
        </div>
      </div>
      <div class="stage" id="hero-stage">
        <span class="coin" aria-hidden="true">N</span>
        <span class="coin" aria-hidden="true">N</span>
        <span class="coin" aria-hidden="true">N</span>
        <span class="coin" aria-hidden="true">N</span>
        <Kip alt="Kip, the KYP padlock mascot. Click Kip to open the lock." />
        <div class="bubble" id="hero-bubble" aria-live="polite">Hi, I'm Kip. I keep presale tokens safe.</div>
      </div>
    </div>
  </section>

  <section class="rules full-bleed" id="how">
    <div class="wrap">
      <div class="head reveal">
        <h2>Four rules every launch follows</h2>
        <p>The terms are public before anyone buys, and the lock is built into the launch itself.</p>
      </div>
      <div class="grid">
        <article class="step reveal">
          <svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="12" fill="#1d1250"/><path d="M4 32q28-34 56 0q-28 34-56 0z" fill="none" stroke="#1d1250" stroke-width="5"/><circle cx="36" cy="28" r="4" fill="#fff"/></svg>
          <div class="n">1</div>
          <h3>Everyone's visible</h3>
          <p>Size, terms and milestones are public. Wallets are revealed in waves after launch, smallest first.</p>
        </article>
        <article class="step reveal">
          <svg viewBox="0 0 64 64" aria-hidden="true"><rect x="12" y="28" width="40" height="28" rx="9" fill="#1d1250"/><path d="M20 30V22a12 12 0 0 1 24 0v8" stroke="#1d1250" stroke-width="6" fill="none" stroke-linecap="round"/></svg>
          <div class="n">2</div>
          <h3>Everyone's locked</h3>
          <p>Presale tokens enter the lock in the same transaction that opens the pool.</p>
        </article>
        <article class="step reveal">
          <svg viewBox="0 0 64 64" aria-hidden="true"><circle cx="32" cy="32" r="24" fill="#1d1250"/><path d="M22 34h20M22 26h20" stroke="#ff6fa5" stroke-width="6" stroke-linecap="round"/></svg>
          <div class="n">3</div>
          <h3>One price</h3>
          <p>All fills settle together at the opening price. Nobody gets a cheaper entry.</p>
        </article>
        <article class="step reveal">
          <svg viewBox="0 0 64 64" aria-hidden="true"><path d="M8 54L26 30l12 12 18-26" stroke="#1d1250" stroke-width="6" fill="none" stroke-linecap="round" stroke-linejoin="round"/><circle cx="56" cy="16" r="5" fill="#1d1250"/></svg>
          <div class="n">4</div>
          <h3>Unlock at milestones</h3>
          <p>TWAP-verified FDV targets, such as $10m. The community roots for presalers to get there.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="demo full-bleed" id="demo">
    <div class="wrap">
      <div class="head reveal">
        <h2>Drag the market cap and watch Kip</h2>
        <p>Each milestone opens a slice of the locked supply. The tiers below are an example, since every launcher sets their own.</p>
      </div>
      <div class="panel reveal">
        <div class="stage">
          <Kip alt="Kip reacts to the market cap you choose" />
        </div>
        <div>
          <div class="fdv" id="demo-fdv">$0m</div>
          <p class="sub" id="demo-unl">0% of presale tokens unlocked</p>
          <input type="range" id="demo-range" min="0" max="30" step="0.5" value="0" aria-label="Fully diluted valuation in millions of dollars" />
          <div class="tiers" id="demo-tiers"></div>
          <p class="note">Example values only. Unlocks are verified by TWAP, not a single spike.</p>
        </div>
      </div>
    </div>
  </section>

  <section class="launches full-bleed" id="launches">
    <div class="wrap">
      <div class="lhead reveal">
        <div><h2>Launches</h2></div>
        <a class="btn p" href="/create">+ New launch</a>
      </div>
      <LaunchList client:only="solid-js" />
    </div>
  </section>

  <script is:inline>
    (function () {
      var reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      // headline word animation
      var h = document.getElementById("hero-title");
      if (h) {
        var words = h.textContent.trim().split(" ");
        h.setAttribute("aria-label", h.textContent.trim());
        h.innerHTML = words.map(function (w, i) {
          return '<span class="w" aria-hidden="true" style="opacity:0;transform:translateY(40px) rotate(4deg);display:inline-block;animation:rise .8s cubic-bezier(.2,1.3,.4,1) forwards;animation-delay:' + (0.1 + i * 0.07) + 's">' + w + "</span>";
        }).join(" ");
        if (!document.getElementById("rise-anim")) {
          var style = document.createElement("style");
          style.id = "rise-anim";
          style.textContent = "@keyframes rise{to{opacity:1;transform:none}}";
          document.head.appendChild(style);
        }
      }

      // Kip eyes follow pointer
      var kips = [].slice.call(document.querySelectorAll("svg.kip"));
      function look(e) {
        kips.forEach(function (k) {
          var r = k.getBoundingClientRect();
          var cx = r.left + r.width * 0.5, cy = r.top + r.height * 0.56;
          var dx = e.clientX - cx, dy = e.clientY - cy;
          var d = Math.hypot(dx, dy) || 1, m = Math.min(6, d / 40);
          [].forEach.call(k.querySelectorAll(".pupil"), function (p) {
            p.style.transform = "translate(" + (dx / d * m) + "px," + (dy / d * m) + "px)";
          });
        });
      }
      if (!reduce) window.addEventListener("pointermove", look);

      // hero Kip click + bubble
      var heroKip = document.querySelector("#hero-stage svg.kip");
      var bubble = document.getElementById("hero-bubble");
      var lines = [
        "Hi, I'm Kip. I keep presale tokens safe.",
        "Everyone buys at one price.",
        "Locked until the milestone hits.",
        "Wallets get revealed, smallest first.",
        "Click me to peek inside!"
      ];
      var li = 0;
      function say(t) {
        if (!bubble) return;
        bubble.classList.add("out");
        setTimeout(function () { bubble.textContent = t; bubble.classList.remove("out"); }, 280);
      }
      if (heroKip) {
        heroKip.addEventListener("click", function () {
          heroKip.classList.toggle("open");
          say(heroKip.classList.contains("open") ? "Only at a public milestone. Not yet!" : "Locked up tight.");
        });
      }
      if (!reduce && bubble) {
        setInterval(function () { li = (li + 1) % lines.length; say(lines[li]); }, 4200);
      }

      // unlock demo
      var tiers = [
        { m: 2, p: 10 },
        { m: 5, p: 20 },
        { m: 10, p: 30 },
        { m: 25, p: 40 }
      ];
      var tw = document.getElementById("demo-tiers");
      var range = document.getElementById("demo-range");
      var fdv = document.getElementById("demo-fdv");
      var unl = document.getElementById("demo-unl");
      var dk = document.querySelector("#demo .panel svg.kip");
      if (tw && range && fdv && unl) {
        tw.innerHTML = tiers.map(function (t) {
          return '<div class="tier"><b>$' + t.m + 'm</b><span>+' + t.p + '% opens</span></div>';
        }).join("");
        var els = [].slice.call(tw.children);
        var last = 0;
        function burst() {
          if (reduce || !dk) return;
          var r = dk.getBoundingClientRect();
          var x = r.left + r.width / 2, y = r.top + r.height * 0.3;
          for (var i = 0; i < 16; i++) {
            var b = document.createElement("i");
            b.className = "burst";
            var a = Math.random() * Math.PI * 2, d = 60 + Math.random() * 90;
            b.style.left = x + "px";
            b.style.top = y + "px";
            b.style.setProperty("--x", Math.cos(a) * d + "px");
            b.style.setProperty("--y", (Math.sin(a) * d - 40) + "px");
            b.style.background = ["#ffd23f", "#4df0bb", "#ff6fa5"][i % 3];
            document.body.appendChild(b);
            setTimeout(function (n) { n.remove(); }, 950, b);
          }
        }
        function update() {
          var v = +range.value;
          var n = 0, total = 0;
          tiers.forEach(function (t, i) {
            var on = v >= t.m;
            els[i].classList.toggle("on", on);
            if (on) { n++; total += t.p; }
          });
          fdv.textContent = "$" + v + "m";
          unl.textContent = total + "% of presale tokens unlocked";
          range.style.setProperty("--p", (v / 30 * 100) + "%");
          if (dk) dk.classList.toggle("open", n > 0);
          if (n > last) burst();
          last = n;
        }
        range.addEventListener("input", update);
        update();
      }
    })();
  </script>
</Base>

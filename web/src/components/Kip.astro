---
export interface Props {
  alt?: string;
}
const { alt = "Kip, the Know Your Cabal padlock mascot" } = Astro.props;
---
<svg class="kip" viewBox="0 0 220 250" role="img" aria-label={alt}>
  <ellipse class="shadow" cx="110" cy="238" rx="70" ry="9" fill="#000" opacity="0.28"/>
  <g class="kipwrap">
    <g class="shackle"><path d="M72 84V58a38 38 0 0 1 76 0v26" fill="none" stroke="#ece9ff" stroke-width="18" stroke-linecap="round"/></g>
    <rect x="26" y="80" width="168" height="150" rx="48" fill="#ffd23f"/>
    <path d="M44 100q50-22 130 0" stroke="#fff3b0" stroke-width="8" fill="none" stroke-linecap="round" opacity="0.8"/>
    <circle cx="62" cy="168" r="13" fill="#ff6fa5" opacity="0.75"/><circle cx="158" cy="168" r="13" fill="#ff6fa5" opacity="0.75"/>
    <g class="eye"><circle cx="80" cy="140" r="19" fill="#fff"/><circle class="pupil" cx="80" cy="141" r="9" fill="#1d1250"/><circle cx="83" cy="137" r="3" fill="#fff"/></g>
    <g class="eye"><circle cx="140" cy="140" r="19" fill="#fff"/><circle class="pupil" cx="140" cy="141" r="9" fill="#1d1250"/><circle cx="143" cy="137" r="3" fill="#fff"/></g>
    <path class="smile" d="M96 176q14 14 28 0" stroke="#1d1250" stroke-width="6" fill="none" stroke-linecap="round"/>
    <path class="grin" d="M92 172q18 26 36 0z" fill="#1d1250"/>
    <path class="grin" d="M100 183q10 8 20 0" stroke="#ff6fa5" stroke-width="5" fill="none" stroke-linecap="round"/>
    <circle cx="110" cy="208" r="7" fill="#c99a00"/><rect x="107" y="208" width="6" height="12" rx="3" fill="#c99a00"/>
  </g>
</svg>
